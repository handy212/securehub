DJANGO_SECRET_KEY=replace-with-a-local-dev-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_DB_NAME=alarmhub
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=postgres
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_USE_SQLITE=True

HIK_PARTNER_BASE_URL=https://example.hik-partner-pro.local
HIK_PARTNER_API_KEY=replace-with-your-hik-api-key
HIK_PARTNER_API_SECRET=replace-with-your-hik-api-secret
HIK_PARTNER_DRY_RUN=True

CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Email (set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend for real delivery)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@securehub.local

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Keep false in production unless public self-enrollment is intentionally enabled.
SECUREHUB_GOOGLE_AUTO_CREATE_USERS=False

# Keep this outside the repository, for example:
# FIREBASE_CREDENTIALS_PATH=/home/you/.config/securehub/firebase-admin.json
# Or configure GOOGLE_APPLICATION_CREDENTIALS for ADC instead.
FIREBASE_CREDENTIALS_PATH=

# Hubtel SMS (https://developers.hubtel.com)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_NAME=SecureHub
